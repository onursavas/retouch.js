{
  "name": "@retouchjs/ml",
  "version": "0.0.1",
  "description": "Rétouch ML tools — on-device background removal and more, via ONNX Runtime Web",
  "author": "",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  },
  "peerDependencies": {
    "@retouchjs/core": "workspace:^"
  },
  "devDependencies": {
    "@retouchjs/core": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
