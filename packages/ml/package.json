{
  "name": "@retouchjs/ml",
  "version": "0.1.0",
  "description": "Rétouch ML tools — on-device cutout, 4× upscale, erase, click-to-select, depth bokeh, denoise and face/object detection via ONNX Runtime Web",
  "author": "Onur Savas",
  "license": "MIT",
  "homepage": "https://github.com/onursavas/retouch.js/tree/main/packages/ml#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onursavas/retouch.js.git",
    "directory": "packages/ml"
  },
  "bugs": {
    "url": "https://github.com/onursavas/retouch.js/issues"
  },
  "keywords": [
    "retouch",
    "image-editor",
    "onnx",
    "onnxruntime-web",
    "webgpu",
    "background-removal",
    "super-resolution",
    "inpainting",
    "segment-anything",
    "depth-estimation",
    "denoise"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  },
  "peerDependencies": {
    "@retouchjs/core": "workspace:^"
  },
  "devDependencies": {
    "@retouchjs/core": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
