{
  "name": "@retouchjs/core",
  "version": "0.1.0",
  "description": "Rétouch — a drop-in, canvas-based image and video editor: crop, adjust, filters, curves, masks, trim, AI edits, plugin tools",
  "author": "Onur Savas",
  "license": "MIT",
  "homepage": "https://onursavas.github.io/retouch.js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onursavas/retouch.js.git"
  },
  "bugs": {
    "url": "https://github.com/onursavas/retouch.js/issues"
  },
  "keywords": [
    "canvas",
    "image-editor",
    "photo-editor",
    "video-editor",
    "retouch",
    "crop",
    "filters",
    "webcodecs",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "build": "tsup",
    "build:all": "pnpm run build && pnpm --filter @retouchjs/ml build",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p packages/ml --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fabric": "^7.2.0",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.46.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "vitest-canvas-mock": "^0.3.0"
  }
}
